# 要監看的 YouTube 頻道（網址，例如 https://www.youtube.com/@xxxx）
CHANNEL_URL=https://www.youtube.com/@CHANGE_ME
# 標題關鍵字過濾（選填，留空則取今天最新一場直播）
TITLE_KEYWORD=

GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Telegram（選填，空白則不發）
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Email（選填，Gmail 請用「應用程式密碼」）
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=
SMTP_PASSWORD=
EMAIL_TO=
